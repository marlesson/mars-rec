# MARS-Rec — local environment overrides
#
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored; this template is the only env file in version control.
#
# Variables here are auto-loaded by the Makefile via `-include .env`.
# They take precedence over the Makefile defaults but can still be
# overridden per-invocation: `make GCP_PROJECT=other-id <target>`.

# -----------------------------------------------------------------------------
# Google Cloud — required by docker-push, docker-pull, gcp-create-repo,
# gcp-submit, vertex-run.
# -----------------------------------------------------------------------------
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET=gs://your-bucket-name

# -----------------------------------------------------------------------------
# Container image — usually fine to leave as-is.
# -----------------------------------------------------------------------------
IMAGE_NAME=mars-rec
IMAGE_TAG=latest
